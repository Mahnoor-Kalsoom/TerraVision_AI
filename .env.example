# FloodVision AI — Environment Variables Template
# Copy to .env (backend) and frontend/.env.local and fill in values.

# ------------------------------------------------
# Backend (root .env — loaded by pydantic-settings)
# ------------------------------------------------

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000

# Absolute or relative path to the trained U-Net model
MODEL_PATH=backend/models/flood_unet_final.keras

# Maximum upload size per image in bytes (default: 10 MB)
MAX_UPLOAD_BYTES=10485760

# Rate limiting for the /analyze endpoint (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=10

# Set to true only in development — enables detailed error messages in logs
DEBUG=false

# ------------------------------------------------
# Frontend (frontend/.env.local)
# ------------------------------------------------

# URL of the running FastAPI backend (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000
